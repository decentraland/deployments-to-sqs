{
  "name": "deployments-to-sqs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose",
    "lint:check": "eslint '**/*.{js,ts}'"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^1.1.12",
    "@dcl/test-helpers": "^0.3.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.6.0"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.616.0",
    "@dcl/catalyst-storage": "^5.0.0",
    "@dcl/core-commons": "0.11.0",
    "@dcl/fetch-component": "^1.1.2",
    "@dcl/http-server": "^2.4.0",
    "@dcl/metrics": "^1.0.1",
    "@dcl/schemas": "^15.3.3",
    "@dcl/snapshots-fetcher": "^11.0.0",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/interfaces": "^1.5.2",
    "@well-known-components/logger": "^3.1.3"
  }
}
